[
  {
    "label": "Debug sandbox (gdb)",
    "adapter": "GDB",
    "request": "launch",
    "build": {
      "command": "mingw32-make",
      "args": ["example", "BUILD=debug"],
      "cwd": "$ZED_WORKTREE_ROOT"
    },
    "program": "$ZED_WORKTREE_ROOT/build/debug/examples/sandbox.exe",
    "cwd": "$ZED_WORKTREE_ROOT",
    "stopAtBeginningOfMainSubprogram": false
  }
]
